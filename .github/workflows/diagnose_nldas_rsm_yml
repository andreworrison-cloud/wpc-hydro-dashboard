name: Diagnose NLDAS-2 Noah RSM Feed

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  diagnose-nldas-rsm:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install ecCodes system library
        run: |
          sudo apt-get update
          sudo apt-get install -y libeccodes0

      - name: Install Python dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests numpy xarray h5netcdf h5py eccodes

      - name: Run NLDAS-2 RSM feed diagnostic
        run: python diagnose_nldas_rsm.py

      - name: Upload diagnostic report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: nldas-rsm-diagnostic
          path: |
            nldas_rsm_diagnostic.json
          if-no-files-found: warn
          retention-days: 14
